; PPA-1 PIMG graphics loader (PPA-1 ASM)
; (c) 2026 Adam Cir (Adava), Adava Software, Adava Development
;
; Requires PPA-VGA/1 in any active slot, discovered by vga_init.
; Register bank and its next VRAM bank come from the cached slot.
; Reads PIMG resources generated by tools/rompack/ppa_rompack.c
; from EEPROM banks 0001-001F using the bank register BR.
;
;  PIMG format (all offsets relative to start of ROM bank):
;  0000 'PIMG', 0004 version=1, 0005 format=1 (indexed 8-bit)
;  0006 width LE16, 0008 height LE16, 000A count LE16
;  000C pixel offset LE16=0400h, 000E palette offset=0010h
;  0010..030F RGB triples, 0400.. pixel indices row-major.
;
; Public routines:
;   gfx_show_screen: A = ROM bank low (1..31).
;                    Loads 256 VGA DAC colors and copies exactly
;                    320x200 pixels to selected VGA VRAM, returns A=1/0.
;   gfx_apply_palette: A = ROM bank, set common 256-color DAC palette.
;   gfx_draw_sprite: A = ROM bank, Y = VRAM offset of top-left pixel.
;                    Width 1..255, height 1..200 (PIMG header),
;                    *no clipping*: caller must keep sprite on screen.
;                    Does not change DAC; all assets use shared palette.
;   gfx_copy_screen: A = ROM bank, copy 64000 pixel bytes (no validation).
;
; RAM 1000:0030..0036 reserved while graphics functions run.
; No host-side BMP decoding: the converter runs BEFORE the emulator.

GFX_ROM_PALETTE      EQU $0010
GFX_ROM_PIXELS       EQU $0400
GFX_RAM_BANK         EQU $0030
GFX_RAM_DEST_HI      EQU $0031
GFX_RAM_DEST_LO      EQU $0032
GFX_RAM_WIDTH        EQU $0033
GFX_RAM_HEIGHT       EQU $0034
GFX_RAM_STEP_LO      EQU $0035
GFX_RAM_STEP_HI      EQU $0036

gfx_show_screen:
    ; Only a PIMG 320x200 8-bpp image is valid for a full screen.
    MOV D,A
    MOV BR-HI,#00
    MOV BR-LO,D
    LD A,$0000
    CMP A,#50
    JNZ .invalid
    LD A,$0001
    CMP A,#49
    JNZ .invalid
    LD A,$0002
    CMP A,#4D
    JNZ .invalid
    LD A,$0003
    CMP A,#47
    JNZ .invalid
    LD A,$0004
    CMP A,#01
    JNZ .invalid
    LD A,$0005
    CMP A,#01
    JNZ .invalid
    LD A,$0006
    CMP A,#40
    JNZ .invalid
    LD A,$0007
    CMP A,#01
    JNZ .invalid
    LD A,$0008
    CMP A,#C8
    JNZ .invalid
    LD A,$0009
    CMP A,#00
    JNZ .invalid

    ; D is preserved across direct loads. gfx_apply_palette modifies D,
    ; so save the bank number in scratch RAM.
    MOV BR-HI,#10
    MOV BR-LO,#00
    ST $0030,D

    MOV A,D
    CALL gfx_apply_palette
    MOV BR-HI,#10
    MOV BR-LO,#00
    LD A,$0030
    CALL gfx_copy_screen
    MOV A,#01
    RET
.invalid:
    MOV A,#00
    RET

gfx_apply_palette:
    ; VGA DAC index 0, RGB bytes from PIMG palette region.
    MOV D,A
    CALL slots_use_vga
    MOV A,#00
    ST $0014,A
    MOV X-HI,#00
    MOV X-LO,#10
.next:
    MOV BR-HI,#00
    MOV BR-LO,D
    LD B,X
    INC X-LO
    JNZ .rno
    INC X-HI
.rno:
    CALL slots_use_vga
    ST $0015,B

    MOV BR-HI,#00
    MOV BR-LO,D
    LD B,X
    INC X-LO
    JNZ .gno
    INC X-HI
.gno:
    CALL slots_use_vga
    ST $0016,B

    MOV BR-HI,#00
    MOV BR-LO,D
    LD B,X
    INC X-LO
    JNZ .bno
    INC X-HI
.bno:
    CALL slots_use_vga
    ST $0017,B

    CMP X-HI,#03
    JNZ .next
    CMP X-LO,#10
    JNZ .next
    RET

gfx_copy_screen:
    ; Source ROM X=0400h, dest VRAM Y=0000h;
    ; 64000 bytes -> source ends FE00h, VGA dest ends FA00h.
    MOV D,A
    MOV X-HI,#04
    MOV X-LO,#00
    MOV Y-HI,#00
    MOV Y-LO,#00
.copy:
    MOV BR-HI,#00
    MOV BR-LO,D
    LD B,X
    CALL slots_use_vga_vram
    ST Y,B
    INC X-LO
    JNZ .src_no_carry
    INC X-HI
.src_no_carry:
    INC Y-LO
    JNZ .dst_no_carry
    INC Y-HI
.dst_no_carry:
    CMP Y-HI,#FA
    JNZ .copy
    CMP Y-LO,#00
    JNZ .copy
    RET

gfx_draw_sprite:
    ; A=ROM bank, Y=destination linear offset (X is changed).
    MOV D,A
    MOV BR-HI,#10
    MOV BR-LO,#00
    ST $0031,Y-HI
    ST $0032,Y-LO
    MOV BR-HI,#00
    MOV BR-LO,D
    LD A,$0000
    CMP A,#50
    JNZ .invalid
    LD A,$0001
    CMP A,#49
    JNZ .invalid
    LD A,$0002
    CMP A,#4D
    JNZ .invalid
    LD A,$0003
    CMP A,#47
    JNZ .invalid
    LD A,$0004
    CMP A,#01
    JNZ .invalid
    LD A,$0005
    CMP A,#01
    JNZ .invalid
    LD A,$0007
    CMP A,#00
    JNZ .invalid
    LD A,$0009
    CMP A,#00
    JNZ .invalid
    LD B,$0006
    CMP B,#00
    JZ .invalid
    LD C,$0008
    CMP C,#00
    JZ .invalid

    ; Row advance after copying width pixels = 320 - width.
    MOV BR-HI,#10
    MOV BR-LO,#00
    ST $0033,B
    ST $0034,C
    MOV A,#40
    SUB A,B
    ST $0035,A
    JC .gap_hi0
    MOV A,#01
    JMP .gap_ready
.gap_hi0:
    MOV A,#00
.gap_ready:
    ST $0036,A

    LD Y-HI,$0031
    LD Y-LO,$0032
    MOV X-HI,#04
    MOV X-LO,#00
    LD C,$0034
.row:
    LD B,$0033
.pixel:
    MOV BR-HI,#00
    MOV BR-LO,D
    LD A,X
    CALL slots_use_vga_vram
    ST Y,A
    INC X-LO
    JNZ .src_no_carry
    INC X-HI
.src_no_carry:
    INC Y-LO
    JNZ .dest_no_carry
    INC Y-HI
.dest_no_carry:
    DEC B
    JNZ .pixel
    DEC C
    JZ .complete
    MOV BR-HI,#10
    MOV BR-LO,#00
    LD A,$0035
    ADD Y-LO,A
    JNC .row_no_carry
    INC Y-HI
.row_no_carry:
    LD A,$0036
    ADD Y-HI,A
    JMP .row
.complete:
    MOV A,#01
    RET
.invalid:
    MOV A,#00
    RET
