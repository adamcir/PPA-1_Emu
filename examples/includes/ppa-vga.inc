; PPA-VGA/1 shared ASM definitions for SLOT 1.
; Registers: bank 2000. VRAM: bank 2001, addresses 0000-F9FF.
; Mode 0 = 320x200x8 indexed color.

VGA_CONTROL EQU $0010
VGA_STATUS EQU $0011
VGA_MODE EQU $0012
VGA_BORDER EQU $0013
VGA_DAC_INDEX EQU $0014
VGA_DAC_R EQU $0015
VGA_DAC_G EQU $0016
VGA_DAC_B EQU $0017
VGA_WIDTH_LO EQU $0018
VGA_WIDTH_HI EQU $0019
VGA_HEIGHT_LO EQU $001A
VGA_HEIGHT_HI EQU $001B

vga_init:
    MOV BR-HI,#20
    MOV BR-LO,#00
    MOV A,#00
    ST $0012,A
    ST $0013,A
    MOV A,#01
    ST $0010,A
    RET

vga_off:
    MOV BR-HI,#20
    MOV BR-LO,#00
    MOV A,#00
    ST $0010,A
    RET
